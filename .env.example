GA4_PROPERTY_ID=432233519

# Optional. Defaults point to the sibling webscraping project:
# ..\webscraping\config\client_secret.json
# ..\webscraping\config\token.json
GA4_CLIENT_SECRET_FILE=
GA4_TOKEN_FILE=

# Optional alternative for service-account based auth.
GOOGLE_APPLICATION_CREDENTIALS=

# Google Ad Manager.
# Create this from config/googleads.yaml.example, or point to an existing
# googleads.yaml file.
GAM_CONFIG_FILE=config/googleads.yaml
GAM_API_VERSION=v202602
GAM_APPLICATION_NAME=Advertiser Dashboard Automation
GAM_NETWORK_CODE=
GAM_SERVICE_ACCOUNT_KEY_FILE=
GAM_SERVICE_ACCOUNT_JSON=
GAM_CLIENT_ID=
GAM_CLIENT_SECRET=
GAM_REFRESH_TOKEN=

# Webinar.net.
WEBINAR_NET_API_KEY=
WEBINAR_NET_API_SECRET=
WEBINAR_NET_BASE_URL=https://api.webinar.net
WEBINAR_NET_WEBINARS_PATH=/v1/webinars
WEBINAR_NET_ATTENDEES_PATH_TEMPLATE=/v1/webinars/{webinar_id}/registrants
WEBINAR_NET_USER_AGENT=sme-advertiser-dashboard/1.0
# Auth mode options: headers, bearer, query.
WEBINAR_NET_AUTH_MODE=headers
ADV_MFG_WEBINARS_URL=https://www.advancedmanufacturing.org/resources/webinars/

# HubSpot private app token for Marketing Emails API reads.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com
# Optional. Defaults to data/newsletter_placements.csv, then eNewsletter Ad Metrics.csv.
HUBSPOT_NEWSLETTER_PLACEMENTS_FILE=
