# Copy this file to .env for local testing.
# Never commit real tokens, passwords, service account JSON, or refresh tokens.

# Google Sheets
# Used for the Advertiser Source sheet and Master Digital Metrics File.
ADVERTISER_SOURCE_SHEET_NAME=Advertiser Source
ADVERTISER_SOURCE_WORKSHEET_NAME=advertisers
ADVERTISER_SOURCE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# HubSpot
# Used for eNewsletter and custom email reporting.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

# Google Ad Manager
# Used for website ad metrics and advertiser-list refreshes.
GAM_CONFIG_FILE=config/googleads.yaml
GAM_API_VERSION=v202602
GAM_APPLICATION_NAME=Advertiser Dashboard Automation
GAM_NETWORK_CODE=
GAM_SERVICE_ACCOUNT_KEY_FILE=
GAM_SERVICE_ACCOUNT_JSON=
GAM_CLIENT_ID=
GAM_CLIENT_SECRET=
GAM_REFRESH_TOKEN=

# Optional GA4 settings.
# GA4 code exists, but the current Streamlit dashboard primarily uses Google Ad Manager for website ads.
GA4_PROPERTY_ID=432233519
GA4_CLIENT_SECRET_FILE=
GA4_TOKEN_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
